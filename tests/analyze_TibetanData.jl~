### Define helper function to safely convert string entries to Float64 for data arrays that include missing-value indicators.  Function returns type Matrix{Union{Float64, Missing}}

function parse_value_Float(x)
    if x isa Number
        return Float64(x)
    elseif x isa AbstractString
        parsed = tryparse(Float64, strip(x))
        return parsed === nothing ? missing : parsed
    end
    return x
end

### Define helper function to safely convert string entries to Int64 for data arrays that include missing-value indicators.  Function returns type Matrix{Union{Int64, Missing}}

function parse_value_Int(x)
    if x isa Number
        return Int(x)
    elseif x isa AbstractString
        parsed = tryparse(Int, strip(x))
        return parsed === nothing ? missing : parsed
    end
    return x
end



### Assign constants in data set

n = 120     # no. sites
Kmax = 83   # maximum no. surveys per site
m = 13      #  no. species

pcovs = 7   # no. regressors of occurrence (including intercept)
qcovs = 2   # no. regressors of detection  (including intercept)




### Read data from flat files and resize arrays

## ... read data from flat files

Y_flat = readdlm("Y_TibetanData.csv", Any)
X_flat = readdlm("X_TibetanData.csv", Any)
V_flat = readdlm("V_TibetanData.csv", Any)

## ... replace string indicators of missing values with Julia's 'missing'

Y_cleaned = replace(Y_flat, "" => missing, "NA" => missing, "N/A" => missing)
X_cleaned = replace(X_flat, "" => missing, "NA" => missing, "N/A" => missing)
V_cleaned = replace(V_flat, "" => missing, "NA" => missing, "N/A" => missing)

## ... convert type from Any to Matrix{Union{Int, Missing}}

Y = parse_value_Int.(Y_cleaned)

## ... convert type from Any to Matrix{Union{Float64, Missing}}

X = parse_value_Float.(X_cleaned)
V = parse_value_Float.(V_cleaned)

## ... resize arrays

Y = reshape(Y, n, Kmax, m)
V = reshape(V, n, Kmax, qcovs)
X = reshape(X, n, pcovs)


## ... construct lists of data arrays used to fit models

data = dataList(Y, X, V)   # full data set with all covariates and species


cov_index = [1, 3, 4]
X_subset = reshape(X[:, cov_index], n, length(cov_index))
data = dataList(Y, X_subset, V)



### Fit MP model using MCMC algorithm

dt_start = now()

niter = 40000
niterInterval = 5000
burnin = 20000
quiet = false

mc = runMCMC(data, niter, niterInterval, quiet)

dt_finish = now()


println("\n", "Total elapsed hours = ", round((dt_finish - dt_start) / Dates.Hour(1), digits=2) )





### Estimate posterior summary statistics for correlations in occurrence between species (R)

mc_param = mc.vecR
mc_param_name = mc.vecR_name

## ... save posterior quantiles as a dataframe

posteriorSeq = (burnin+1):niter

chain = Chains(mc_param[posteriorSeq, :], mc_param_name)


df = DataFrame(quantile(chain, q=[0.50, 0.025, 0.975]))
posterior_quantiles = transform(df, names(df, Float64) .=> (x -> round.(x; digits=2)) .=> names(df, Float64)) # round df to 2 digits

println(posterior_quantiles)

CSV.write("posterior_summary_R.csv", df)


## ... optionally, write Markov chain to csv file for analysis by non-Julia software

df = DataFrame(mc_param, mc_param_name)
CSV.write("markov_chain_R.csv", df)




